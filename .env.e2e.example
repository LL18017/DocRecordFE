# Cuentas para las pruebas end-to-end (Playwright).
#
# Copie este archivo a `.env.e2e`, rellene las credenciales de SU entorno de
# desarrollo y expórtelas antes de correr las pruebas. `.env.e2e` está ignorado
# por git a propósito: una contraseña committeada sigue estando en el historial
# aunque después se borre del archivo.
#
#   Windows (PowerShell):
#     Get-Content .env.e2e | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#     pnpm test:e2e
#
#   Linux / macOS:
#     set -a && . ./.env.e2e && set +a && pnpm test:e2e
#
# REQUISITOS antes de correr:
#   · Backend en :8080 con su base en :5433
#   · Las dos cuentas deben tener AL MENOS UNA CLÍNICA ASIGNADA, o el flujo se
#     detiene en la pantalla de selección de sede. Se asignan desde
#     «Usuarios y Roles» → botón «Sedes».
#   · La cuenta de enfermería necesita además su ficha en la tabla `enfermeras`,
#     que se crea sola al asignarle el rol ENFERMERA.

# Cuenta con rol MEDICO (puede abrir /consultas y /prescripciones)
E2E_MEDICO_EMAIL=
E2E_MEDICO_PASSWORD=

# Cuenta con rol ENFERMERA (NO debe tener el rol MEDICO, o las pruebas
# negativas pasarían por el motivo equivocado)
E2E_ENFERMERA_EMAIL=
E2E_ENFERMERA_PASSWORD=
