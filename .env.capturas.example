# Cuentas para el script de capturas del Laboratorio 2.
#
# Copie este archivo a `.env.capturas`, rellene las credenciales y expórtelas
# antes de correr el script. `.env.capturas` NO debe versionarse: una contraseña
# commiteada sigue estando en el historial aunque después se borre del archivo.
#
#   Windows (PowerShell):
#     Get-Content .env.capturas | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }
#     node scripts/capturas-lab2.mjs
#
#   Linux / macOS / Git Bash:
#     set -a && . ./.env.capturas && set +a && node scripts/capturas-lab2.mjs
#
# ── Antes de correr ───────────────────────────────────────────────────────
# Las cuatro cuentas tienen que EXISTIR en el despliegue. Al 16 de septiembre de
# 2026 no existen: las cuatro responden 404 «No se encontró al usuario». Se
# crean con el script del backend, que es idempotente y pide una cuenta ADMIN
# ya existente:
#
#   python3 DocRecordBE/despliegue/crear-cuentas-demo.py \
#       https://docrecordsv.duckdns.org <correo-del-admin>
#
# El administrador del despliegue lo creó `AdminBootstrap` al arrancar, a partir
# de ADMIN_EMAIL y ADMIN_PASSWORD en `/opt/docrecord/.env` dentro de la
# instancia. Si nadie recuerda esa contraseña, se cambia con
# `DocRecordBE/despliegue/cambiar-clave-admin.sh` desde el servidor.
#
# Además, el personal necesita AL MENOS UNA CLÍNICA ASIGNADA o el flujo se
# detiene en la pantalla de selección de sede. `crear-cuentas-demo.py` ya crea
# la clínica de demostración y se las asigna.

CAP_ADMIN_EMAIL=admin.demo@docrecordsv.sv
CAP_ADMIN_PASSWORD=

CAP_MEDICO_EMAIL=medico.demo@docrecordsv.sv
CAP_MEDICO_PASSWORD=

CAP_ENFERMERA_EMAIL=enfermera.demo@docrecordsv.sv
CAP_ENFERMERA_PASSWORD=

CAP_PACIENTE_EMAIL=paciente.demo@docrecordsv.sv
CAP_PACIENTE_PASSWORD=

# Opcionales: solo si se quiere apuntar a otro entorno o a otra carpeta.
# CAP_BASE_URL=https://docrecordsv.duckdns.org
# CAP_API_URL=https://api-docrecordsv.duckdns.org
# CAP_DESTINO=
